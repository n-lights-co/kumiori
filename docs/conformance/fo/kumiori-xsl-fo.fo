  <!-- ================================================================ 表紙 -->
  <fo:page-sequence master-reference="cover" force-page-count="no-force">
    <fo:flow flow-name="xsl-region-body">
      <fo:block-container absolute-position="absolute" top="34mm" left="18mm" width="100mm">
        <fo:block line-height="0"><fo:external-graphic src="images/kumiori-logo.svg" content-width="100mm"/></fo:block>
      </fo:block-container>
      <fo:block-container absolute-position="absolute" top="96mm" left="18mm" width="146mm">
        <fo:block border-before-style="solid" border-before-width="1.2pt" border-before-color="#C9482B" padding-before="7mm" font-family="sans-serif" font-size="10pt" color="#C9482B" letter-spacing="0.2em">KUMIORI SUPPORTED SPECIFICATIONS</fo:block>
        <fo:block font-family="sans-serif" font-weight="bold" font-size="30pt" line-height="1.3" color="#1E3550" space-before="4mm">対応仕様説明書</fo:block>
        <fo:block font-family="sans-serif" font-size="17pt" color="#1E3550" space-before="1mm">XSL-FO 1.1 編</fo:block>
        <fo:block font-size="9.5pt" line-height="1.8" color="#3b4245" space-before="12mm">XSL-FO 1.1 の要素とプロパティを項目ごとに取り上げ、仕様の原文、Kumiori での扱い、Kumiori で組んだ例、その見本のコードを並べました。この文書そのものも XSL-FO で書かれ、Kumiori で組まれています。</fo:block>
        <fo:block font-size="8pt" line-height="1.7" color="#6b7275" space-before="6mm">MathML の例 (XSL-FO の中に置いたもの)、Kumiori が扱える画像の形式の見本、アンテナハウスの拡張 (axf:) の付録を含みます。HTML と CSS の項目は、別の文書「HTML と CSS 編」にあります。</fo:block>
      </fo:block-container>
      <fo:block-container absolute-position="absolute" top="236mm" left="18mm" width="146mm">
        <fo:block border-before-style="solid" border-before-width="0.5pt" border-before-color="#1E3550" padding-before="2.5mm" font-family="sans-serif" font-size="8pt" color="#6b7275">Kumiori — Apache License 2.0 — Northern Lights Co.</fo:block>
      </fo:block-container>
    </fo:flow>
  </fo:page-sequence>

  <!-- ================================================================ 目次 -->
