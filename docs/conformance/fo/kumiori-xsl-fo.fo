<fo:bookmark internal-destination="ch-table"><fo:bookmark-title>6　表</fo:bookmark-title><fo:bookmark internal-destination="s-6-1"><fo:bookmark-title>6.1　fo:table・border-collapse・number-columns-spanned</fo:bookmark-title></fo:bookmark><fo:bookmark internal-destination="s-6-2"><fo:bookmark-title>6.2　fo:table-and-caption</fo:bookmark-title></fo:bookmark></fo:bookmark>
