  <!-- ================================================================ Cover -->
  <fo:page-sequence master-reference="cover" force-page-count="no-force">
    <fo:flow flow-name="xsl-region-body">
      <fo:block-container absolute-position="absolute" top="34mm" left="18mm" width="100mm">
        <fo:block line-height="0"><fo:external-graphic src="images/kumiori-logo.svg" content-width="100mm"/></fo:block>
      </fo:block-container>
      <fo:block-container absolute-position="absolute" top="96mm" left="18mm" width="146mm">
        <fo:block border-before-style="solid" border-before-width="1.2pt" border-before-color="#C9482B" padding-before="7mm" font-family="sans-serif" font-size="10pt" color="#C9482B" letter-spacing="0.2em">KUMIORI SUPPORTED SPECIFICATIONS</fo:block>
        <fo:block font-family="sans-serif" font-weight="bold" font-size="30pt" line-height="1.3" color="#1E3550" space-before="4mm">Conformance Guide</fo:block>
        <fo:block font-family="sans-serif" font-size="17pt" color="#1E3550" space-before="1mm">XSL-FO 1.1</fo:block>
        <fo:block font-size="9.5pt" line-height="1.8" color="#3b4245" space-before="12mm">This guide takes up the elements and properties of XSL-FO 1.1 one item at a time, placing side by side the text of the specification, how Kumiori handles it, an example typeset by Kumiori, and the sample code behind it. This document itself is written in XSL-FO and typeset by Kumiori.</fo:block>
        <fo:block font-size="8pt" line-height="1.7" color="#6b7275" space-before="6mm">It includes MathML examples (placed inside XSL-FO), samples of the image formats Kumiori can handle, and an appendix on the AH Formatter extensions (axf:). The HTML and CSS items are in a separate document, the HTML and CSS edition.</fo:block>
      </fo:block-container>
      <fo:block-container absolute-position="absolute" top="236mm" left="18mm" width="146mm">
        <fo:block border-before-style="solid" border-before-width="0.5pt" border-before-color="#1E3550" padding-before="2.5mm" font-family="sans-serif" font-size="8pt" color="#6b7275">Kumiori — Apache License 2.0 — Northern Lights Co.</fo:block>
      </fo:block-container>
    </fo:flow>
  </fo:page-sequence>

