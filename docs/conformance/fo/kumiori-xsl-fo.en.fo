<?xml version="1.0" encoding="UTF-8"?>
<!--
  Kumiori Conformance Guide — XSL-FO 1.1
  When this file is typeset with Kumiori, it becomes a document that, for each XSL-FO 1.1 item, places side by side the text of the specification, how Kumiori handles it, the sample code and the typeset example.
  Each sample is written once, between the processing instructions kumiori-sample (start) and kumiori-sample-end (end). When the document is typeset, a display of that code is inserted before the sample
  (scripts/build-conformance.mjs, npm run docs:conformance). The same samples are typeset as tests by test/conformance.test.ts.
  Sentences from the W3C specifications are quoted verbatim as retrieved, and the source and the retrieval date are recorded in the "Sources" appendix. The AH Formatter extensions (axf:) are described in Kumiori's own words (the product manual is not quoted).
-->
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format" xmlns:axf="http://www.antennahouse.com/names/XSL/Extensions"
  xml:lang="en" font-family="serif" font-size="9.5pt" line-height="1.75" color="#24292c">
  <fo:layout-master-set>
    <!-- Cover: no margins, white background -->
    <fo:simple-page-master master-name="cover" page-width="182mm" page-height="257mm">
      <fo:region-body/>
    </fo:simple-page-master>
    <!-- Body: odd and even pages swap the gutter (inner) and fore-edge (outer) margins -->
    <fo:simple-page-master master-name="odd" page-width="182mm" page-height="257mm" margin-top="12mm" margin-bottom="10mm" margin-left="20mm" margin-right="0mm">
      <fo:region-body margin-top="12mm" margin-bottom="12mm" margin-right="16mm"/>
      <fo:region-before region-name="head-odd" extent="9mm"/>
      <fo:region-after region-name="foot-odd" extent="9mm"/>
      <fo:region-end region-name="tab-odd" extent="9mm"/>
    </fo:simple-page-master>
    <fo:simple-page-master master-name="even" page-width="182mm" page-height="257mm" margin-top="12mm" margin-bottom="10mm" margin-left="0mm" margin-right="20mm">
      <fo:region-body margin-top="12mm" margin-bottom="12mm" margin-left="16mm"/>
      <fo:region-before region-name="head-even" extent="9mm"/>
      <fo:region-after region-name="foot-even" extent="9mm"/>
      <fo:region-start region-name="tab-even" extent="9mm"/>
    </fo:simple-page-master>
    <!-- Multi-column chapter: region-body in 2 columns -->
    <fo:simple-page-master master-name="odd-2col" page-width="182mm" page-height="257mm" margin-top="12mm" margin-bottom="10mm" margin-left="20mm" margin-right="0mm">
      <fo:region-body margin-top="12mm" margin-bottom="12mm" margin-right="16mm" column-count="2" column-gap="7mm"/>
      <fo:region-before region-name="head-odd" extent="9mm"/>
      <fo:region-after region-name="foot-odd" extent="9mm"/>
      <fo:region-end region-name="tab-odd" extent="9mm"/>
    </fo:simple-page-master>
    <fo:simple-page-master master-name="even-2col" page-width="182mm" page-height="257mm" margin-top="12mm" margin-bottom="10mm" margin-left="0mm" margin-right="20mm">
      <fo:region-body margin-top="12mm" margin-bottom="12mm" margin-left="16mm" column-count="2" column-gap="7mm"/>
      <fo:region-before region-name="head-even" extent="9mm"/>
      <fo:region-after region-name="foot-even" extent="9mm"/>
      <fo:region-start region-name="tab-even" extent="9mm"/>
    </fo:simple-page-master>
    <fo:page-sequence-master master-name="book">
      <fo:repeatable-page-master-alternatives>
        <fo:conditional-page-master-reference master-reference="odd" odd-or-even="odd"/>
        <fo:conditional-page-master-reference master-reference="even" odd-or-even="even"/>
      </fo:repeatable-page-master-alternatives>
    </fo:page-sequence-master>
    <fo:page-sequence-master master-name="book-2col">
      <fo:repeatable-page-master-alternatives>
        <fo:conditional-page-master-reference master-reference="odd-2col" odd-or-even="odd"/>
        <fo:conditional-page-master-reference master-reference="even-2col" odd-or-even="even"/>
      </fo:repeatable-page-master-alternatives>
    </fo:page-sequence-master>
  </fo:layout-master-set>

  <fo:declarations>
    <axf:document-info name="document-title" value="Kumiori Conformance Guide — XSL-FO 1.1"/>
    <axf:document-info name="author" value="Kumiori"/>
  </fo:declarations>

