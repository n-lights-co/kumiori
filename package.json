{
  "name": "kumiori",
  "version": "0.2.0",
  "description": "Kumiori (組み織り) — Japanese typesetting engine for browsers and Node: HTML+CSS / XSL-FO -> Area Tree -> Canvas / PDF",
  "keywords": [
    "typesetting",
    "japanese",
    "組版",
    "pdf",
    "xsl-fo",
    "css",
    "paged-media",
    "vertical-writing",
    "ruby"
  ],
  "homepage": "https://github.com/n-lights-co/kumiori#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n-lights-co/kumiori.git"
  },
  "bugs": {
    "url": "https://github.com/n-lights-co/kumiori/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist-lib/index.js",
  "types": "./dist-lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/types/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./node": {
      "types": "./dist-lib/types/node.d.ts",
      "import": "./dist-lib/node.js"
    },
    "./browser": {
      "types": "./dist-lib/types/index.d.ts",
      "default": "./dist-browser/kumiori.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist-lib",
    "dist-cli",
    "dist-browser",
    "assets/logo",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CHANGELOG.en.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "build:cli": "vite build --ssr src/cli.ts --outDir dist-cli --emptyOutDir",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "build:browser": "vite build --config vite.browser.config.ts",
    "build:dist": "npm run build:lib && npm run build:cli && npm run build:browser",
    "docs:conformance": "node scripts/build-conformance.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build:dist"
  },
  "license": "Apache-2.0",
  "author": "Northern Lights Co.",
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@xmldom/xmldom": "^0.9.12",
    "hyphen": "^1.14.1",
    "linkedom": "^0.18.14",
    "pdf-lib": "^1.17.1",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "bin": {
    "kumiori": "dist-cli/cli.js"
  },
  "publishConfig": {
    "access": "public"
  }
}
